# Production environment variables for Azure deployment
# Copy this to .env.production.local and fill in your actual Azure URLs
# These are baked into the bundle at build time by Vite — never commit real values to git

# Your Azure App Service / Container Apps backend URL
VITE_API_BASE_URL=https://your-backend.azurewebsites.net/api

# Same backend URL for WebSocket connections (must use wss:// in production — handled automatically)
VITE_SOCKET_URL=https://your-backend.azurewebsites.net
